# OpenHealthKit Configuration Environment Variables
# Copy this file to .env for local development

# Environment Mode: development | staging | production
ENV_MODE=development

# Application Secrets (CHANGE IN PRODUCTION)
# Generate secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Options: sqlite | postgresql
DATABASE_TYPE=sqlite

# SQLite settings (used when DATABASE_TYPE=sqlite)
SQLITE_DB_PATH=./openhealthkit.db

# PostgreSQL settings (used when DATABASE_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openhealth
POSTGRES_PASSWORD=openhealth_secret_pass
POSTGRES_DB=openhealthkit_db

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=100

# Default System Admin Credentials (For initial seed in development only)
INITIAL_ADMIN_EMAIL=admin@openhealthkit.org
INITIAL_ADMIN_PASSWORD=AdminPass123!ChangeMe

# i18n
DEFAULT_LOCALE=en

# Redis (Optional caching & pub/sub)
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false
